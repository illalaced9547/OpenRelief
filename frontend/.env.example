# Base URL of the live inference endpoint (src/open_relief/serve.py), e.g.
# https://<job>.<region>.nebius.cloud - no trailing slash.
# Used by the chat panel for real per-question generation. The map always reads
# the static snapshot (src/data/live-predictions.json) regardless of this value.
# When unset, chat falls back to that same snapshot, then to synthetic demo answers.
VITE_INFERENCE_URL=
# Server-only Vercel environment variable; never use a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
